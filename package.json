{
  "name": "yu-ai-rain-film",
  "version": "1.0.0",
  "private": true,
  "description": "Rain Love: V1, V2 and V3 continuous kinetic typography",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "prepare:media": "python scripts/prepare.py",
    "check": "tsc --noEmit && node scripts/validate.mjs",
    "stills": "node scripts/render.mjs stills",
    "preview": "node scripts/render.mjs preview",
    "render": "node scripts/render.mjs film",
    "verify": "node scripts/verify.mjs",
    "verify:preview": "python scripts/verify-preview.py",
    "contact-sheet": "python scripts/contact-sheet.py",
    "check:v2": "tsc --noEmit && node scripts/validate-v2.mjs",
    "glyphs:v2": "node scripts/glyphs-v2.mjs",
    "keyframes:v2": "node scripts/render-v2.mjs keyframes",
    "audit:v2": "node scripts/render-v2.mjs audit",
    "preview:v2": "node scripts/render-v2.mjs preview",
    "render:v2": "node scripts/render-v2.mjs film",
    "verify:v2": "node scripts/verify-v2.mjs",
    "verify:preview:v2": "node scripts/verify-v2.mjs --preview && python scripts/verify-preview.py --v2",
    "contact-sheet:v2": "python scripts/contact-v2.py",
    "check:v3": "tsc --noEmit && node scripts/validate-v3.mjs",
    "analyze:v3": ".venv-alignment/Scripts/python.exe scripts/analyze-v3.py",
    "glyphs:v3": "node scripts/glyphs-v3.mjs",
    "stills:v3": "node scripts/render-v3.mjs stills",
    "audit:v3": "node scripts/render-v3.mjs audit",
    "bridges:v3": "node scripts/render-v3.mjs bridge",
    "preview:verse:v3": "node scripts/render-v3.mjs verse",
    "preview:chorus:v3": "node scripts/render-v3.mjs chorus",
    "render:v3": "node scripts/render-v3.mjs film",
    "verify:v3": "node scripts/verify-v3.mjs",
    "inspect:v3": "python scripts/inspect-video-v3.py",
    "verify:previews:v3": "node scripts/verify-v3.mjs --previews && python scripts/verify-preview-v3.py",
    "contact-sheet:v3": "python scripts/contact-v3.py",
    "package:v3": "python scripts/package-v3.py"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/motion-blur": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "opentype.js": "1.3.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "typescript": "5.8.3"
  }
}
